APP_ENV=development
LOG_LEVEL=info,soldisco_server=debug

API_HOST=127.0.0.1
API_PORT=8080
WEB_ORIGIN=http://localhost:3000

DATABASE_URL=postgres://soldisco:replace-with-local-password@127.0.0.1:5432/soldisco
DATABASE_MAX_CONNECTIONS=5
DATABASE_MAX_BYTES=5368709120
DISCOVERY_SNAPSHOT_LIMIT=500
RETENTION_TERMINAL_HISTORY_HOURS=24
RETENTION_PROJECTION_EVENTS_HOURS=24
RETENTION_QUARANTINE_HOURS=168
RETENTION_INTERVAL_MS=60000
RETENTION_BATCH_SIZE=5000

SOLANA_NETWORK=mainnet
SOLANA_RPC_HTTP_URL=https://api.mainnet-beta.solana.com
SOLANA_RPC_WS_URL=wss://api.mainnet-beta.solana.com
SOLANA_COMMITMENT=confirmed
SOLANA_REQUEST_TIMEOUT_MS=5000
SOLANA_RECONNECT_DELAY_MS=1000
SOLANA_RPC_MAX_IN_FLIGHT=4
SOLANA_DISCOVERY_RPC_REQUESTS_PER_SECOND=1
SOLANA_DISCOVERY_RPC_RATE_LIMIT_COOLDOWN_MS=5000
SOLANA_SUBSCRIPTION_IDLE_TIMEOUT_MS=30000
DISCOVERY_MAX_EVENT_AGE_MS=15000
DISCOVERY_OBSERVATION_WINDOW_MS=60000
DISCOVERY_MAX_ACTIVE_WINDOWS=128
COLLECTOR_QUEUE_CAPACITY=2048
STREAM_START_TIMEOUT_MS=20000

SOLDISCO_POSTGRES_DB=soldisco
SOLDISCO_POSTGRES_USER=soldisco
SOLDISCO_POSTGRES_PASSWORD=replace-with-local-password
SOLDISCO_POSTGRES_PORT=5432
