{
  "name": "@soldisco/web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.18.0"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log node --env-file-if-exists=../../.env ./node_modules/vinext/dist/cli.js dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log node --env-file-if-exists=../../.env ./node_modules/vinext/dist/cli.js build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log node --env-file-if-exists=../../.env ./node_modules/vinext/dist/cli.js start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:packages": "tsc -p ../../packages/tsconfig.json",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "quality": "npm run lint && npm run typecheck && npm run typecheck:packages && npm test"
  },
  "dependencies": {
    "lucide-react": "^1.27.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.47.0",
    "@cloudflare/workers-types": "5.20260728.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-react": "6.0.4",
    "@vitejs/plugin-rsc": "0.5.30",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vinext": "0.0.55",
    "vite": "8.1.5",
    "wrangler": "4.114.0"
  },
  "overrides": {
    "sharp": "0.35.2",
    "next": {
      "postcss": "8.5.23"
    }
  },
  "type": "module",
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "workerd@1.20260722.1": true
  }
}
